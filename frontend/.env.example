# Browser-visible Supabase project settings. Use the project URL and publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Optional when the API Gateway is not running at localhost:8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Rural Health Companion Environment Configuration Template

# Eureka Discovery Server
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Database credentials (generate separate values with: openssl rand -hex 32).
# If reusing an existing MySQL volume, MYSQL_ROOT_PASSWORD must match its current root password.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=

# JWT signing secret (generate a fresh random value of at least 32 bytes)
# Example: openssl rand -base64 48
JWT_SECRET=

# Required to create an ADMIN account through registration. Keep it server-side.
ADMIN_REGISTRATION_CODE=

# Supabase Auth email OTP. The publishable key is safe for client use; never put a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Kafka Bootstrap Server (Optional Event Broker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_KAFKA_TOPIC=rhc.notification.events
NOTIFICATION_KAFKA_ENABLED=true

# Firebase Admin uses Application Default Credentials; never put credential JSON in this file.
# With FCM enabled, set FIREBASE_CREDENTIALS_HOST_PATH and use docker-compose.fcm.yml.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_HOST_PATH=

# Frontend Portal URL (CORS Origin)
FRONTEND_URL=http://localhost:3000

# Microservice Ports
PORT_GATEWAY=8080
PORT_AUTH=8081
PORT_USER=8082
PORT_DOCTOR=8083
PORT_APPOINTMENT=8084
PORT_CONSULTATION=8085
PORT_PRESCRIPTION=8086
PORT_MEDICINE=8087
PORT_PHARMACY=8088
PORT_AMBULANCE=8089
PORT_NOTIFICATION=8090
PORT_EUREKA=8761

# Nearby pharmacy provider (backend only; never expose GOOGLE_PLACES_API_KEY to Next.js)
NEARBY_PHARMACY_PROVIDER=osm
NEARBY_PHARMACY_RADIUS_METERS=5000
OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_OVERPASS_FALLBACK_ENDPOINT=https://lz4.overpass-api.de/api/interpreter
GOOGLE_PLACES_ENDPOINT=https://maps.googleapis.com/maps/api/place/nearbysearch/json
GOOGLE_PLACES_API_KEY=
PHARMACY_SEED_DATA_ENABLED=false

# Prescription OCR uses the read-only service-account mount configured in docker-compose.yml.
